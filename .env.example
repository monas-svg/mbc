# ---------------------------------------------------------------------------
# Variables d'environnement - Application de gestion MBCODE
#
# Copiez ce fichier vers .env et renseignez des valeurs adaptees a votre
# environnement. Ne jamais committer le fichier .env reel dans le depot.
# ---------------------------------------------------------------------------

# Django
DJANGO_SECRET_KEY=changez-moi-avec-une-cle-secrete-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
DJANGO_LOG_LEVEL=INFO
TIME_ZONE=Africa/Douala

# Base de donnees PostgreSQL
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_BASE
DATABASE_URL=postgres://mbcode:mbcode_password@db:5432/mbcode

# Utilise par docker-compose pour initialiser le conteneur PostgreSQL
POSTGRES_DB=mbcode
POSTGRES_USER=mbcode
POSTGRES_PASSWORD=mbcode_password

# Securite (HTTPS) - a activer en production derriere un reverse proxy TLS
SECURE_SSL_REDIRECT=False

# CORS (si l'API est consommee par un client externe)
CORS_ALLOWED_ORIGINS=

# Compte administrateur cree automatiquement au demarrage du conteneur web
# si aucun compte administrateur n'existe encore (laisser vide pour desactiver)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=changez-ce-mot-de-passe
DJANGO_SUPERUSER_EMAIL=admin@mbcode.cm
